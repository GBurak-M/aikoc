# Google Gemini AI (ücretsiz katman — Google AI Studio)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Vercel: Project → Settings → Environment Variables → GEMINI_API_KEY
# Yerel: .env.local dosyasına aynı anahtarı ekleyin

# İsteğe bağlı model (varsayılan: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Gemini'yi kapatmak için (öğretmen bankası + tarayıcı modeli devreye girer):
# VITE_GEMINI_ENABLED=false

# Tarayıcıda ücretsiz LLM (WebLLM — WebGPU gerekir, ilk yüklemede ~500MB model indirir):
# VITE_BROWSER_LLM_ENABLED=false
