# Kütüphane yönetici PIN (production'da mutlaka değiştirin)
LIBRARY_ADMIN_PIN=aikoc2026

# Opsiyonel: yönetici e-postaları (virgülle ayrılmış, Google oturumu ile giriş)
# LIBRARY_ADMIN_EMAILS=admin@ornek.com

# Kalıcı kitap yükleme — Vercel Blob (production'da otomatik bağlanır)
# Yerel geliştirme: vercel env pull
# BLOB_READ_WRITE_TOKEN=

# Kalıcı kitap listesi — Upstash Redis (Vercel Marketplace)
# Kurulum: vercel integration add upstash/upstash-kv -n rotaai-library-kv
# (Önce tarayıcıda Upstash şartlarını kabul edin)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# AI Sohbet & Soru Çöz — Groq (öğretmen modu)
# https://console.groq.com/keys
GROQ_API_KEY=
# Opsiyonel model (varsayılan: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.1-8b-instant
